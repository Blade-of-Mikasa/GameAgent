{
  "name": "game-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A layered game SDK and Pi decision kernel",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/app/main.ts",
    "start:live": "npm start -- --live",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "eval": "tsx evals/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
