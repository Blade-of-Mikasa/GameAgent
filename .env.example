# Offline mode uses a scripted model transport through the real Pi Agent loop.
GAME_AGENT_MODE=offline
GAME_AGENT_PROVIDER=deepseek
GAME_AGENT_MODEL=deepseek-flash
GAME_AGENT_BUDGET_MS=10000
GAME_AGENT_RUNS_DIR=runs
# npm run start:live reads DEEPSEEK_API_KEY from your process environment.
# No need to copy an existing global key into this file.
# Optional Anthropic: GAME_AGENT_PROVIDER=anthropic, GAME_AGENT_MODEL=claude-sonnet-4-6,
# and ANTHROPIC_API_KEY in the environment.
